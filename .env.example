# これを .env にコピーして使う（.env はGit管理外）
# SECRET_KEY は推測不能なランダム値にする。生成例:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-string

# 本番(HTTPS)で公開するときは 1 にする（CookieにSecure属性が付く）。
# ローカル開発(HTTP)では 0 のまま（1にするとCookieがブラウザからサーバへ送られずログインできなくなる）。
SECURE_COOKIES=0
